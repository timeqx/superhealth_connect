{
  "name": "superhealth-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.database.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "staff:provision": "node scripts/provision-staff.mjs",
    "email:worker": "node scripts/email-worker.mjs",
    "test:email": "node --test scripts/email-delivery.test.mjs",
    "db:types": "supabase gen types typescript --local > src/shared/supabase/database.generated.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.71.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "pg": "^8.20.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
}
