NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required by the server for validated private ID uploads only. Never use NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# Operator-only PostgreSQL connection for scripts/provision-staff.mjs.
# Not needed by the running Next.js application.
STAFF_DATABASE_URL=
# Exact trusted application origin for email links; do not derive from request headers.
APP_URL=http://localhost:3000
# Optional isolated LOCAL PostgreSQL test database. Never use a pilot/production database.
TEST_DATABASE_URL=
# Server-only notification worker. Never use NEXT_PUBLIC_ for these values.
EMAIL_DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
# Set only after the center approves a review deadline; blank disables overdue alerts.
APPOINTMENT_REVIEW_HOURS=
